# Copy to .env and fill in real values. Never commit .env.
# The same file serves local development (npm run dev + docker-compose.dev.yml)
# and the production stack (docker compose up -d, which reads .env automatically).

# --- Admin account (seed only: `npm run db:seed` / `docker compose run --rm seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Application ---
# IANA time zone used to convert Date + time to timestamps
APP_TIMEZONE=Europe/Paris
# Auth.js secret (at least 32 characters), e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Trust the host / proxy headers (required behind a reverse proxy or in Docker).
# Also makes the login rate limiter trust X-Forwarded-For: the reverse proxy must overwrite it.
AUTH_TRUST_HOST=true

# --- Local development only ---
# PostgreSQL connection string used by Prisma (CLI via prisma.config.ts, and the app).
# Targets the dev database: docker compose -f docker-compose.dev.yml up -d
# (user/password/db must match the POSTGRES_* values below).
# Ignored by docker-compose.yml, which composes it from POSTGRES_* with host `postgres`.
DATABASE_URL=postgresql://activities:change-me@localhost:5432/activities
# Host port of the dev database (docker-compose.dev.yml, bound to 127.0.0.1)
POSTGRES_PORT=5432

# --- PostgreSQL (docker-compose.yml and docker-compose.dev.yml) ---
# Use URL-safe characters in the password (it is embedded in DATABASE_URL), e.g. `openssl rand -hex 24`
POSTGRES_USER=activities
POSTGRES_PASSWORD=change-me
POSTGRES_DB=activities

# --- Production stack only (docker-compose.yml) ---
# Host port published for the app container
APP_PORT=3000
