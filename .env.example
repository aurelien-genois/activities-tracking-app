# Copy to .env and fill in real values. Never commit .env.

# Admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# IANA time zone used to convert Date + time to timestamps
APP_TIMEZONE=Europe/Paris

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://activities:change-me@localhost:5432/activities

# Auth.js secret (at least 32 characters), e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Trust the host / proxy headers (required behind a reverse proxy or in Docker)
AUTH_TRUST_HOST=true

# PostgreSQL container settings (docker compose)
POSTGRES_USER=activities
POSTGRES_PASSWORD=change-me
POSTGRES_DB=activities
